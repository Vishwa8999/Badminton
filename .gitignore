serviceAccount*.json
*.serviceAccount.json
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist

# ----- Node / npm -----------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js

# ----- Build outputs --------------------------------------------
dist/
dist-ssr/
build/
out/
.output/

# ----- Vite / TypeScript ----------------------------------------
*.tsbuildinfo
vite.config.ts.timestamp-*

# ----- IDE / Editor -----------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ----- OS files --------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----- Android (Gradle) ------------------------------------------
.gradle/
.kotlin/
/local.properties
local.properties
/captures
.externalNativeBuild
.cxx
debug.keystore
*.apk
*.aab

# ----- Logs / temp -----------------------------------------------
logs/
*.log
*.tmp
*.temp
.cache/
